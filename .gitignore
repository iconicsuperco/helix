# Data policy: raw data is local or externally versioned; checked-in manifests document it.
datasets/raw/
datasets/interim/
datasets/external/

# Keep the current A1 tokenizer artifact tracked, but ignore future generated variants.
research/tokenizer/artifacts/*
!research/tokenizer/artifacts/tokenizer.json
!research/tokenizer/artifacts/tokenizer_card.md
