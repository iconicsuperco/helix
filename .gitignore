# Python caches and build outputs
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# OS and editor files
.DS_Store
.idea/
.vscode/
*.swp

# Research run outputs and large model artifacts
checkpoints/
runs/
outputs/
wandb/
mlruns/
*.pt
*.pth
*.ckpt
